{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioFlow",
  "version": "0.1.1",
  "identifier": "com.audioflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AudioFlow",
        "width": 1050,
        "height": 700,
        "minWidth": 850,
        "minHeight": 580,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#101113",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "shortDescription": "Automatic audio routing across monitors",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMzhEOTNEQjIxQzQxQ0QKUldUTlFSeXlQZGs0SHZubG5hV2NUT3FGZEFncXdER0NLM3k1UjVRdDVZVXJCS25kcGx4bGNzOTcK",
      "endpoints": [
        "https://github.com/hazavi/AudioFlow/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
